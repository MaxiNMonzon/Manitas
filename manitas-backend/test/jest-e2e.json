{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!.*@nestjs[/+]jwt[/@])"
  ],
  "moduleNameMapper": {
    "^@nestjs/typeorm$": "<rootDir>/../test/stubs/nestjs-typeorm.ts",
    "^@nestjs/config$": "<rootDir>/../test/stubs/nestjs-config.ts"
  }
}
