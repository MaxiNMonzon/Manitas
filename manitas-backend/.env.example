# Copiar este archivo como ".env" y completar los valores. El .env real NO se sube al repositorio.

# Puerto donde levanta la API (por defecto 3000)
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=manitas
# Solo para una base en la nube que pide conexion segura (ej: Aiven): DB_SSL=true y en DB_SSL_CA el
# certificado CA que da el proveedor (el texto entero del archivo ca.pem). En local, DB_SSL=false
DB_SSL=false
DB_SSL_CA=

# Clave para firmar los JWT: un texto largo y aleatorio (ej: el resultado de `openssl rand -hex 32`)
JWT_SECRET=

# Administrador (maneja los catálogos y lee las consultas de Ayuda)
ADMIN_CORREO=admin@manitas.test
ADMIN_CONTRASENA=

# Mercado Pago (modo prueba): access token de un usuario vendedor de prueba
MERCADOPAGO_ACCESS_TOKEN=
# A dónde vuelve el cliente al tocar "Volver al sitio" después de pagar
MERCADOPAGO_VUELTA_URL=http://localhost:5173/app/solicitudes

# Solo para el seed:demo: contraseña de la cuenta de Maxi (si queda vacía, usa Manitas123)
SEED_CONTRASENA_MAXI=
